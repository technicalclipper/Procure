// Procure — data model
//
// Multi-tenant. A User is a global identity keyed by their Privy DID and
// may belong to many organisations. Everything else is org-scoped.
//
// Money: every amount is `...Minor`, a BigInt count of USDC base units
// (6 decimals). Never a float. See lib/units.ts.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved connection URLs out of the schema.
// Migrate reads them from prisma.config.ts; the client gets a driver
// adapter (see lib/db.ts).
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────

/// A person. Global — not owned by any organisation.
model User {
  id String @id @default(cuid())

  /// Privy DID (auth token claims.userId). The identity anchor: a row is
  /// created the first time someone signs in, and matched by it thereafter.
  privyDid String @unique

  email String  @unique
  name  String?

  /// The user's own Privy embedded wallet. Approvers sign with this — the
  /// key is theirs, not ours, which is what makes an approval a signature
  /// rather than a row we could have written ourselves.
  walletAddress String?

  orgMemberships    OrgMember[]
  deptMemberships   Membership[]
  requests          PurchaseRequest[] @relation("Requester")
  approvals         Approval[]
  receipts          GoodsReceipt[]
  invitationsSent   Invitation[]      @relation("InvitedBy")
  organizationsOwned Organization[]   @relation("OrgOwner")

  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Organisation & membership
// ─────────────────────────────────────────────────────────────

model Organization {
  id   String @id @default(cuid())
  /// URL segment: /o/[slug]
  slug String @unique
  name String

  ownerId String
  owner   User   @relation("OrgOwner", fields: [ownerId], references: [id])

  /// Privy organization wallet holding the org float.
  treasuryWalletId String?
  treasuryAddress  String?
  treasuryPolicyId String?

  members     OrgMember[]
  departments Department[]
  invitations Invitation[]
  vendors     Vendor[]
  items       Item[]
  accounts    Account[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Org-level standing. Department-scoped powers live in Membership.
enum OrgRole {
  /// Created the org. Cannot be removed.
  OWNER
  /// Manages departments, budgets, masters, vendors and invitations.
  CONTROLLER
  /// Belongs to the org; actual powers come from department memberships.
  MEMBER
}

model OrgMember {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  orgRole OrgRole @default(MEMBER)

  joinedAt DateTime @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

/// Department-scoped role. Per (user, department) — the same person can
/// raise requests in Engineering and approve for Marketing.
enum Role {
  REQUESTER
  APPROVER
}

model Membership {
  id String @id @default(cuid())

  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  role         Role

  @@unique([userId, departmentId, role])
  @@index([departmentId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// An invitation is matched on email at accept time: whoever signs in with
/// that address gets the org standing and department role chosen here.
model Invitation {
  id    String @id @default(cuid())
  token String @unique

  email String

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  orgRole OrgRole @default(MEMBER)

  /// Optional department role granted on accept.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  role         Role?

  status    InvitationStatus @default(PENDING)
  expiresAt DateTime

  invitedById String
  invitedBy   User   @relation("InvitedBy", fields: [invitedById], references: [id])

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@index([email, status])
  @@index([orgId, status])
}

model Department {
  id   String @id @default(cuid())
  name String
  code String

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Privy server wallet, provisioned on creation. Pre-funded to exactly
  /// its budget, so a department physically cannot overspend.
  walletId    String?
  address     String?
  policyId    String?
  keyQuorumId String?

  /// Period allocation in USDC base units
  budgetMinor BigInt @default(0)

  /// Cash account in the chart of accounts for this wallet
  cashAccountCode String?

  memberships Membership[]
  requests    PurchaseRequest[]
  orders      PurchaseOrder[]
  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, code])
}

// ─────────────────────────────────────────────────────────────
// Masters
// ─────────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id      String      @id @default(cuid())
  code    String
  name    String
  type    AccountType
  subtype String?
  active  Boolean     @default(true)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  items        Item[]
  journalLines JournalLine[]

  @@unique([orgId, code])
}

model Item {
  id          String  @id @default(cuid())
  code        String
  name        String
  description String?
  unit        String  @default("unit")

  /// Default rate in USDC base units
  defaultRateMinor BigInt @default(0)

  /// Drives automatic GL coding on purchase request lines
  expenseAccountCode String?
  expenseAccount     Account? @relation(fields: [expenseAccountId], references: [id])
  expenseAccountId   String?

  category String?
  active   Boolean @default(true)

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  lines PurchaseRequestLine[]

  @@unique([orgId, code])
}

enum VendorStatus {
  DRAFT
  ACTIVE
  BLOCKED
}

enum RiskBand {
  UNSCREENED
  BLOCKED
  REVIEW
  CLEAR
}

model Vendor {
  id    String @id @default(cuid())
  name  String
  email String

  /// Payout address — only enters the Privy allowlist after risk screening
  payoutAddress String

  paymentTerms  String       @default("Net 30")
  category      String?
  apAccountCode String?
  status        VendorStatus @default(DRAFT)

  riskScore      Int?
  riskBand       RiskBand  @default(UNSCREENED)
  riskAssessedAt DateTime?
  riskNarrative  String?
  riskSignals    Json?
  /// Set when a controller force-approves a BLOCKED address
  overrideReason String?

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  requests PurchaseRequest[]
  orders   PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
}

// ─────────────────────────────────────────────────────────────
// Procure to pay
// ─────────────────────────────────────────────────────────────

enum PRStatus {
  DRAFT
  SUBMITTED
  PRECHECK_FAILED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model PurchaseRequest {
  id       String   @id @default(cuid())
  prNumber String   @unique
  status   PRStatus @default(DRAFT)

  justification   String?
  rejectionReason String?

  amountMinor BigInt @default(0)

  requesterId  String
  requester    User       @relation("Requester", fields: [requesterId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  vendorId     String
  vendor       Vendor     @relation(fields: [vendorId], references: [id])

  lines     PurchaseRequestLine[]
  approvals Approval[]
  order     PurchaseOrder?

  /// Snapshotted at submit time so later policy changes don't move the bar
  approvalsRequired Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, departmentId])
}

model PurchaseRequestLine {
  id          String @id @default(cuid())
  description String
  quantity    Int    @default(1)

  unitRateMinor BigInt
  amountMinor   BigInt

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id])

  /// Snapshotted from the item so later master changes don't rewrite history
  expenseAccountCode String?

  requestId String
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Approval {
  id String @id @default(cuid())

  requestId String
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  approverId String
  approver   User   @relation(fields: [approverId], references: [id])

  approved Boolean
  comment  String?

  /// Signature from the approver's own Privy wallet
  signature String?

  createdAt DateTime @default(now())

  @@unique([requestId, approverId])
}

enum POStatus {
  ISSUED
  VENDOR_ACCEPTED
  VENDOR_REJECTED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id       String   @id @default(cuid())
  poNumber String   @unique
  status   POStatus @default(ISSUED)

  amountMinor  BigInt
  toleranceBps Int    @default(100)

  onchainTxHash String?
  onchainPoId   String?

  vendorResponseAt     DateTime?
  vendorResponseReason String?

  requestId String          @unique
  request   PurchaseRequest @relation(fields: [requestId], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  vendorId     String
  vendor       Vendor     @relation(fields: [vendorId], references: [id])

  receipt  GoodsReceipt?
  invoice  VendorInvoice?
  bill     Bill?
  comments PoComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, departmentId])
}

model PoComment {
  id   String @id @default(cuid())
  body String
  /// "ORG" or "VENDOR"
  author String

  orderId String
  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model GoodsReceipt {
  id        String @id @default(cuid())
  grnNumber String @unique

  receivedById String
  receivedBy   User   @relation(fields: [receivedById], references: [id])

  note String?

  orderId String        @unique
  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model VendorInvoice {
  id                  String @id @default(cuid())
  vendorInvoiceNumber String

  invoicedAmountMinor BigInt

  orderId String        @unique
  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BillStatus {
  RECEIVED
  MATCHING
  MATCH_FAILED
  MATCHED
  SCHEDULED
  PAID
  DISPUTED
}

/// Carries BOTH the PO amount and the vendor's invoiced amount. A bill
/// generated purely from the PO would match itself by construction and the
/// three-way match would be theatre.
model Bill {
  id         String     @id @default(cuid())
  billNumber String     @unique
  status     BillStatus @default(RECEIVED)

  poAmountMinor       BigInt
  invoicedAmountMinor BigInt

  orderId String        @unique
  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  matches MatchResult[]
  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MatchOutcome {
  PASS
  FAIL
}

model MatchResult {
  id      String       @id @default(cuid())
  outcome MatchOutcome
  reason  String?

  varianceMinor  BigInt
  toleranceMinor BigInt

  billId String
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

model Payment {
  id     String        @id @default(cuid())
  status PaymentStatus @default(PENDING)

  amountMinor BigInt

  fromAddress String
  toAddress   String
  txHash      String?
  blockNumber BigInt?
  failReason  String?

  billId String @unique
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
}

// ─────────────────────────────────────────────────────────────
// Ledger
// ─────────────────────────────────────────────────────────────

model JournalEntry {
  id        String   @id @default(cuid())
  entryDate DateTime @default(now())
  memo      String?
  /// "GOODS_RECEIPT" | "BILL" | "PAYMENT"
  sourceType String
  sourceId   String
  /// Reconciliation key — the payment carries its PO reference and the
  /// journal entry carries the hash, so reconciliation is a join.
  txHash String?

  lines JournalLine[]

  createdAt DateTime @default(now())

  @@index([sourceType, sourceId])
}

model JournalLine {
  id String @id @default(cuid())

  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  debitMinor  BigInt @default(0)
  creditMinor BigInt @default(0)

  costCenter String?
  memo       String?
}

// ─────────────────────────────────────────────────────────────
// Notifications & audit
// ─────────────────────────────────────────────────────────────

/// Every email the workflow fires. Always written, even when the mailer is
/// a no-op — this is the outbox panel we demo.
model Notification {
  id String @id @default(cuid())

  event     String
  recipient String
  subject   String
  body      String
  template  String

  sentAt     DateTime?
  providerId String?
  error      String?

  createdAt DateTime @default(now())

  @@unique([event, recipient, template])
  @@index([createdAt])
}

model AuditLog {
  id     String @id @default(cuid())
  actor  String
  action String
  target String
  detail Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
}
